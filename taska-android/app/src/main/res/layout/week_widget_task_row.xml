<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_row"
    android:layout_width="match_parent" android:layout_height="@dimen/widget_row_min_height" android:gravity="center_vertical">
    <ImageView android:id="@+id/widget_task_check" android:layout_width="@dimen/widget_completion_size" android:layout_height="@dimen/widget_completion_size" android:layout_marginEnd="12dp" android:background="@drawable/widget_completion_circle" android:src="@drawable/widget_completion_empty" android:contentDescription="@string/widget_complete_task" />
    <TextView android:id="@+id/widget_task_text" style="@style/Widget_TaskTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" />
</LinearLayout>
