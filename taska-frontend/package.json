{
  "name": "taska-frontend",
  "version": "0.0.1",
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "tailwind:build": "npx @tailwindcss/cli -i src/tailwind-input.css -o src/tailwind-generated.css",
    "tailwind:watch": "npx @tailwindcss/cli -i src/tailwind-input.css -o src/tailwind-generated.css --watch --poll",
    "prestart": "npm run tailwind:build",
    "start": "concurrently \"npm run tailwind:watch\" \"ng serve\"",
    "prebuild": "npm run tailwind:build",
    "build": "ng build",
    "build:prod": "ng build --configuration=production",
    "build:tauri": "ng build --configuration=tauri",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tauri:build": "npx tauri build --target x86_64-pc-windows-msvc",
    "tauri:dev": "npx tauri dev",
    "build:electron:dev": "ng build && electron-builder --win",
    "build:electron:prod": "ng build --configuration=production && electron-builder --win"
  },
  "build": {
    "appId": "com.taska.app",
    "productName": "Taska",
    "directories": {
      "output": "dist-electron",
      "app": "."
    },
    "files": [
      "electron/**/*",
      "dist/taska-frontend/browser/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "electron/icon.png"
    }
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/animations": "^21.2.10",
    "@angular/cdk": "^21.2.8",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "angular-auth-oidc-client": "^21.0.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.2.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "@tailwindcss/cli": "^4.2.4",
    "@tailwindcss/postcss": "^4.2.4",
    "@tauri-apps/cli": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "concurrently": "^9.2.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  }
}
