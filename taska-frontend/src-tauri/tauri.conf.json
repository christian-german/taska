{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taska",
  "version": "0.1.0",
  "identifier": "com.taska.app",
  "build": {
    "frontendDist": "../dist/taska-frontend/browser",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Taska",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
