{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taska",
  "version": "0.0.0",
  "identifier": "com.taska.app",
  "build": {
    "frontendDist": "../dist/taska-frontend/browser",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Taska",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "schemes": ["taska"]
    },
    "updater": {
      "endpoints": [
        "https://github.com/christian-german/taska/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4RUMxMEM2MzQzNDlENTkKUldSWm5UUTB4aERzK0lkT3pITXlNNXgxYWpwSGhiTUFjV3J6Wmx2ZUpiNzFpZUZFOENrOHFzamMK"
    }
  }
}
